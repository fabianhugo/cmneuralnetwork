function hslToHex (h: number, s: number, l: number) {
    h = h % 360
    s = s / 100
    l = l / 100
    c = (1 - Math.abs(2 * l - 1)) * s
    x = c * (1 - Math.abs(h / 60 % 2 - 1))
    m = l - c / 2
    let r, g, b;
if (h < 60) {
        r = c
        g = x
        b = 0
    } else if (h < 120) {
        r = x
        g = c
        b = 0
    } else if (h < 180) {
        r = 0
        g = c
        b = x
    } else if (h < 240) {
        r = 0
        g = x
        b = c
    } else if (h < 300) {
        r = x
        g = 0
        b = c
    } else {
        r = c
        g = 0
        b = x
    }
    r = Math.round((r + m) * 255)
    g = Math.round((g + m) * 255)
    b = Math.round((b + m) * 255)
    return (r << 16) | (g << 8) | b
}

input.onButtonEvent(Button.AB, input.buttonEventClick(), function () {

    radio.sendString("calc")
})
input.onButtonEvent(Button.B, input.buttonEventClick(), function () {
    serial.writeValue("b: ", bias)
    serial.writeLine("ownWeights")
    for (let index3 = 0; index3 <= 3; index3++) {
        serial.writeValue("w" + index3, ownWeights[index3])
        serial.writeValue("inputs" + index3, inputs[index3])
    }
    
})
function rainbow () {
    let brightness;
for (let j = 0; j <= 299; j++) {
        basic.setLedColors(hslToHex(j % 360, 100, 30), hslToHex((j + 30) % 360, 100, 30), hslToHex((j + 60) % 360, 100, 30))
        basic.pause(7)
    }
    // Faden
    for (let p = 0; p <= 30; p++) {
        brightness = Math.max(0, 8 - p * 0.26)
        basic.setLedColors(hslToHex(299 % 360, 100, 30 - p), hslToHex((299 + 30) % 360, 100, 30 - p), hslToHex((299 + 60) % 360, 100, 30 - p))
        basic.pause(7)
    }
    basic.turnRgbLedOff()
}

softSerial.onLine(DigitalPin.P0, softSerial.BaudRate.Baud1200, function (line) {
    inputs[0] = parseFloat(line)
    received[0] = true
    serial.writeLine("inputs[0]: " + inputs[0])
})

softSerial.onLine(DigitalPin.P1, softSerial.BaudRate.Baud1200, function (line) {
    inputs[1] = parseFloat(line)
    received[1] = true
    serial.writeLine("inputs[1]: " + inputs[1])
})

softSerial.onLine(DigitalPin.P2, softSerial.BaudRate.Baud1200, function (line) {
    inputs[2] = parseFloat(line)
    received[2] = true
    serial.writeLine("inputs[2]: " + inputs[2])
})

function sigmoid (num: number) {
    return 1 / (1 + Math.E ** (-num))
}
radio.onReceivedValue(function (name, value) {
    if (name.substr(0, 2) == ownName) {
        for (let index22 = 0; index22 <= 4; index22++) {
            if (name.substr(2, 2) == "w" + index22) {
                ownWeights[index22] = value
                needed[index22] = true
            }
        }
        if (name.substr(2, 1) == "b") {
            bias = value
        }
    }
})
function getNeuronOutput () {
    result=0
    for (let index32 = 0; index32 <= 3; index32++) {
        result = result + inputs[index32] * ownWeights[index32]
    }
    result = result + bias
    return result
}
