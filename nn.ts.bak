serial.writeLine("start")
basic.forever(function () {
    basic.pause(100)
    if (ownWeights[0]) {
        while (!(inputs[0])) {
            basic.pause(100)
        }
    }
    if (ownWeights[1]) {
        while (!(inputs[1])) {
            basic.pause(100)
        }
    }
    if (ownWeights[2]) {
        while (!(inputs[2])) {
            basic.pause(100)
        }
    }
    if (ownWeights[3]) {
        while (!(inputs[3])) {
            basic.pause(100)
        }
    }
    if (ownWeights[0] && inputs[0]) {
        rainbow()
        if (ownName.includes("h")){
            ownOutput = sigmoid(getNeuronOutput())
            serial.writeValue("out " + ownName + ": ", ownOutput )
            softSerial.writeLine(DigitalPin.P3, softSerial.BaudRate.Baud1200, convertToText(ownOutput))
        }
        if (ownName.includes("y")){
            ownOutput = getNeuronOutput()

        }
        
        for (let index322 = 0; index322 <= 3; index322++) {
            inputs[index322] = 0
        }
        if (ownName=="y0"){
            if (ownOutput > outputThreshold){                
                for (let i = 0; i < 5; i++) {
                    basic.setLedColor(basic.rgb(0, 40, 0))
                    basic.pause(50)
                    basic.setLedColor(basic.rgb(0, 0, 0))
                    basic.pause(50)
                }
                basic.showString("nicht frech")
            }
        }
        if (ownName == "y1") {
            if (ownOutput > outputThreshold) {
                for (let i = 0; i < 5; i++) {
                    basic.setLedColor(basic.rgb(40, 0, 0))
                    basic.pause(50)
                    basic.setLedColor(basic.rgb(0, 0, 0))
                    basic.pause(50)
                    }
                basic.showString("frech")
                }
            }
        }
})
